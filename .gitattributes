# testdata/** must check out byte-for-byte identical on every machine and
# every checkout (this worktree, the main checkout, a fresh clone, the
# racing_game submodule, every CI leg). With core.autocrlf=true and no
# .gitattributes, Git LF->CRLF-converts "text-ish" fixture files (e.g.
# testdata/fixtures/regions.json, testdata/golden/*_golden.txt) on
# checkout on Windows, which silently changes their SHA-256 - the exact
# cause of tests/unit/test_fixtures.cpp's provenance-table check failing
# in a fresh Windows worktree while passing in an older checkout whose
# working-tree copy predates this. `-text` disables Git's line-ending
# normalization/conversion entirely for these paths regardless of
# core.autocrlf/core.eol, so every checkout gets the exact bytes Git has
# stored, never a re-encoded copy.
testdata/** -text

# data/road_rules/*.json is embedded into the library and its SHA-256 enters the
# roads.geom release id: it must be byte-identical on every checkout (street fidelity P1).
data/road_rules/** -text

# data/carve/*.json and data/classifiers/*.json are embedded the same way; their SHA-256 enters the
# carved / class layer configs (street fidelity P2).
data/carve/** -text
data/classifiers/** -text

# data/rail_rules/*.json is embedded the same way; its SHA-256 enters the g2m.rail.geom release id (railways R1/R2).
data/rail_rules/** -text
