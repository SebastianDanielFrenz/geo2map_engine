{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-cl-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "debug",
      "displayName": "Windows / clang-cl / Debug",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "/Z7",
        "CMAKE_CXX_FLAGS": "/Z7",
        "CMAKE_EXE_LINKER_FLAGS": "/DEBUG"
      }
    },
    {
      "name": "release",
      "displayName": "Windows / clang-cl / Release",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Windows / clang-cl / RelWithDebInfo",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "displayName": "Windows / clang-cl / ASan",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "G2M_SANITIZER_BUILD": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=address",
        "CMAKE_CXX_FLAGS": "-fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address /OPT:NOICF",
        "CMAKE_TRY_COMPILE_CONFIGURATION": "RelWithDebInfo"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_odr_violation=0"
      }
    },
    {
      "name": "consumer-check",
      "displayName": "Windows / clang-cl / consumer-only configure (PLAN.md G2.0 Task D)",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "G2M_BUILD_IMPORT": "OFF",
        "G2M_BUILD_TESTS": "OFF",
        "G2M_BUILD_APPS": "OFF",
        "G2M_BUILD_HTTP": "OFF"
      }
    },
    {
      "name": "bridge-release",
      "displayName": "Windows / clang-cl / Release + physics_sim bridge (PLAN.md R2.2 G5/G6)",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "G2M_BUILD_IMPORT": "ON",
        "G2M_BUILD_TESTS": "ON",
        "PS_BUILD_TESTS": "OFF",
        "PS_BUILD_GODOT_ADAPTER": "OFF",
        "G2M_PS_SOURCE_DIR": "${sourceDir}/out/ps_pin/src",
        "G2M_BUILD_HTTP": "OFF",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON",
        "FETCHCONTENT_SOURCE_DIR_JOLTPHYSICS": "S:/claude_code/physics_sim/out/build/release/_deps/joltphysics-src",
        "FETCHCONTENT_SOURCE_DIR_NLOHMANN_JSON": "S:/claude_code/physics_sim/out/build/release/_deps/nlohmann_json-src",
        "FETCHCONTENT_SOURCE_DIR_CATCH2": "${sourceDir}/out/build/release/_deps/catch2-src",
        "FETCHCONTENT_SOURCE_DIR_G2M_ZSTD": "${sourceDir}/out/build/release/_deps/g2m_zstd-src",
        "FETCHCONTENT_SOURCE_DIR_G2M_SQLITE": "${sourceDir}/out/build/release/_deps/g2m_sqlite-src",
        "FETCHCONTENT_SOURCE_DIR_G2M_JSON": "${sourceDir}/out/build/release/_deps/g2m_json-src",
        "FETCHCONTENT_SOURCE_DIR_LIBDEFLATE": "${sourceDir}/out/build/release/_deps/libdeflate-src",
        "FETCHCONTENT_SOURCE_DIR_ZLIBNG": "${sourceDir}/out/build/release/_deps/zlibng-src",
        "FETCHCONTENT_SOURCE_DIR_PROTOZERO": "${sourceDir}/out/build/release/_deps/protozero-src",
        "FETCHCONTENT_SOURCE_DIR_LIBOSMIUM": "${sourceDir}/out/build/release/_deps/libosmium-src"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "Windows / cl / Debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "Windows / cl / Release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/${sourceDirName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux / clang / Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "G2M_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux / clang / ASan+UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "G2M_SANITIZER_BUILD": "ON",
        "G2M_BUILD_FUZZERS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux / clang / TSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "G2M_SANITIZER_BUILD": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "consumer-check", "configurePreset": "consumer-check" },
    { "name": "bridge-release", "configurePreset": "bridge-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "bridge-release", "configurePreset": "bridge-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc-release", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan-ubsan", "configurePreset": "linux-asan-ubsan", "output": { "outputOnFailure": true } },
    {
      "name": "linux-tsan", "configurePreset": "linux-tsan", "output": { "outputOnFailure": true },
      "environment": {
        "TSAN_OPTIONS": "$penv{TSAN_OPTIONS} suppressions=${sourceDir}/tools/tsan_suppressions.txt external_symbolizer_path=/usr/bin/addr2line"
      }
    }
  ]
}
